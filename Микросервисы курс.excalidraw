      "isDeleted": false,
      "boundElements": [],
      "updated": 1784354704362,
      "link": null,
      "locked": false,
      "text": "1. Сессии\n2. API-ключ\n3. OAuth2.0\n4. JWT\n5. Логин-пароль",
