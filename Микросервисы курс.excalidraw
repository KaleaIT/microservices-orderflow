    },
    {
      "id": "hnbwGBj_Sdk9qYJu5bub_",
      "type": "text",
      "x": -42.79006932563419,
      "y": 649.5911704491641,
      "width": 419.97186279296875,
      "height": 280,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
