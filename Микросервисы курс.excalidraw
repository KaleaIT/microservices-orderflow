    {
      "id": "Mfwv4gpTvO_1ETKTQWXns",
      "type": "text",
      "x": 962.6946067151341,
      "y": 7334.191205861249,
      "width": 633.3394775390625,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bIP",
      "roundness": null,
      "seed": 622097381,
      "version": 531,
      "versionNonce": 1562163333,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784354160612,
      "link": null,
      "locked": false,
      "text": "Самодостаточный токен, содержит в себе всю нужную инфу\nОдин раз сделал токен и чисто с ним логинишься\n\nИдет в паре с refresh токен, чтобы обновить при истечении\n\nСостоит из 3 частей:\n1) Header: метаданные (напр. алгоритм шифрования)\n2) Payload: основная инфа о пользователе. id и роль\n3) Signature: подпись. \nСоздается и проверяется через jwt_secret_key и payload\nЕсли поменяли payload без jwt_key = подпись будет некорректной",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Самодостаточный токен, содержит в себе всю нужную инфу\nОдин раз сделал токен и чисто с ним логинишься\n\nИдет в паре с refresh токен, чтобы обновить при истечении\n\nСостоит из 3 частей:\n1) Header: метаданные (напр. алгоритм шифрования)\n2) Payload: основная инфа о пользователе. id и роль\n3) Signature: подпись. \nСоздается и проверяется через jwt_secret_key и payload\nЕсли поменяли payload без jwt_key = подпись будет некорректной",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "0ChQ9PntRn3RfkdD51O1Y",
      "type": "text",
      "x": 1425.3856768110077,
      "y": 7126.390198072125,
      "width": 162.1976855501216,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
