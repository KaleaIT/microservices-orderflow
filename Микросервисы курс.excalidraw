    {
      "id": "-iMHW7b7TNkF-U1RudXcB",
      "type": "text",
      "x": 1736.5577284616656,
      "y": 2110.0748599326084,
      "width": 620.4790413473722,
      "height": 385,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bCt",
      "roundness": null,
      "seed": 1834510415,
      "version": 910,
      "versionNonce": 1701524978,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779778716260,
      "link": null,
      "locked": false,
      "text": "Микросервисам приходится обращаться друг\nк другу по REST API.\n\nМинусы:\n1) Пользователь ждёт ответа каждого\nсервиса, хотя его интересует только ответ\n\"Заказ успешно создан\"\n2) Сервисы сильно связаны между собой.\nУпал один — полетела вся система. \n3) Запросы могут не отработать с первого\nраза — пользователь вынужден ждать ретраи",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Микросервисам приходится обращаться друг к другу по REST API.\n\nМинусы:\n1) Пользователь ждёт ответа каждого сервиса, хотя его интересует только ответ \"Заказ успешно создан\"\n2) Сервисы сильно связаны между собой. Упал один — полетела вся система. \n3) Запросы могут не отработать с первого раза — пользователь вынужден ждать ретраи",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "9eDfvdKywG4yEeDMfYYak",
      "type": "rectangle",
      "x": -86.27697261521723,
      "y": 603.5256692849505,
