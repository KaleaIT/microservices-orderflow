      "versionNonce": 561878607,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779698084673,
      "link": null,
      "locked": false,
      "text": "Всё приложение в одном месте\n\n1) API Авторизации\n2) API товаров\n3) API корзины\n4) API заказа\n5) Уведомления\nи тд.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Всё приложение в одном месте\n\n1) API Авторизации\n2) API товаров\n3) API корзины\n4) API заказа\n5) Уведомления\nи тд.",
      "autoResize": true,
      "lineHeight": 1.25
    },
