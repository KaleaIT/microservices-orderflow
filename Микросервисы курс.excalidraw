    {
      "id": "LpKWR1NdTN73AuVeg6zzk",
      "type": "text",
      "x": 575.4666073222238,
      "y": -1190.5395501141006,
      "width": 540.5793579793994,
      "height": 280,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bGN",
      "roundness": null,
      "seed": 1571505729,
      "version": 367,
      "versionNonce": 2115659023,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779703065809,
      "link": null,
      "locked": false,
      "text": "Когда нужны микросервисы:\n1) Нагрузка на какой-то компонент\nвыше, чем на другие. Тогда логично\nмасштабировать конкретно этот сервис\n2) Команде неудобно работать в одной\nкодовой базе (Git-конфликты)\n3) Один сервер Монолита не\nсправляется с нагрузкой",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Когда нужны микросервисы:\n1) Нагрузка на какой-то компонент выше, чем на другие. Тогда логично масштабировать конкретно этот сервис\n2) Команде неудобно работать в одной кодовой базе (Git-конфликты)\n3) Один сервер Монолита не справляется с нагрузкой",
      "autoResize": false,
      "lineHeight": 1.25
    },
